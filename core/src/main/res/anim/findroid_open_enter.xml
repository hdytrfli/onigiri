<?xml version="1.0" encoding="utf-8"?>
<!-- A page emerges over the previous one: a short fade with a barely-there scale, so the change
     reads clearly without any large movement. Mirrors the in-app page transition. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha
        android:duration="220"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="220"
        android:fromXScale="0.97"
        android:fromYScale="0.97"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
