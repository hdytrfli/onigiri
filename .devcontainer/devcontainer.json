{
  "name": "Findroid · adb",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind,consistency=cached",
  "mounts": [
    "source=findroid-adb-keys,target=/root/.android,type=volume"
  ],
  "remoteUser": "root",
  "postCreateCommand": "git config --global --add safe.directory '*' && adb start-server && echo 'adb ready — see .devcontainer/README.md for Wi-Fi pairing'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.autoRepositoryDetection": true,
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
